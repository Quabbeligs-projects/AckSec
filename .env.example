# copy to .env and fill in, .env is never committed
# generate each secret with: python3 -c "import secrets; print(secrets.token_hex(32))"

# development, testing or production (default if missing)
ACKSEC_ENV=development

SECRET_KEY=change-me

# used by docker compose for the mysql container
MYSQL_ROOT_PASSWORD=change-me
MYSQL_APP_PASSWORD=change-me
MYSQL_MIGRATE_PASSWORD=change-me
